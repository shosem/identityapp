<% content_for(:title, 'ログイン') %>
<strong class="block mb-4">ログイン画面</strong>
<div class="bg-white rounded-xl shadow-md p-8 max-w-md">
<%= form_with(url: login_path) do |form| %>
<div class="my-4">
<%= form.label :name, "ニックネーム", class: "text-sm block" %>
<%= form.text_field :name, class: "w-40 px-2  border border-black focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
</div>
<div class="my-4">
<%= form.label :password, "パスワード", class: "text-sm block" %>
<%= form.password_field :password, class: "w-40 px-2  border border-black focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
</div>

<div class="my-4">
  <%= form.submit 'ログイン', class:"inline-block rounded-md bg-blue-700 px-6 py-3 text-sm font-semibold uppercase text-white transition hover:bg-blue-500" %>
 </div>

 <%= link_to "アカウント作成はこちら", new_user_path, class: "text-blue-600 underline hover:text-blue-800 transition-colors duration-200" %>

<% end %>
</div>