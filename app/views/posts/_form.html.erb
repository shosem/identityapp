<div class="container mx-auto px-4 py-12 max-w-2xl">
  <div class="bg-white rounded-xl shadow-lg p-8">
    <h2 class="text-2xl font-bold text-gray-800 mb-8 text-center">
      新規投稿
    </h2>

    <%= form_with(model: post) do |form| %>
      <% if post.errors.any? %>
        <div class="mb-8 bg-red-50 border-l-4 border-red-500 p-4 rounded-r-lg">
          <h3 class="text-lg font-semibold text-red-800 mb-2">
            <%= pluralize(post.errors.count, "件のエラー") %> が発生しています
          </h3>
          <ul class="list-disc list-inside text-sm text-red-700 space-y-1">
            <% post.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <!-- タイトルフィールド -->
      <div class="mb-6">
        <%= form.label :title, "タイトル", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= form.text_field :title, 
                            class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition duration-200",
                            placeholder: "〇〇の調整どう？" %>
      </div>

      <!-- 本文フィールド -->
      <div class="mb-8">
        <%= form.label :text, "内容", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= form.text_area :text, 
                           rows: 8,
                           class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition duration-200 resize-y",
                           placeholder: "言いたいことを言い合おう！" %>
      </div>

      <!-- 写真追加フォーム -->
      <div>
        <%= form.label :post_image, '写真を追加' %>
        <%= form.file_field :post_image, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition duration-200",
                                         placeholder: "写真を追加" %>
        <%= form.hidden_field :post_image_cache %>
      </div>

      <!-- 送信ボタン -->
      <div class="text-center">
        <%= form.submit "登録", 
                        class: "inline-block px-8 py-4 bg-blue-600 text-white font-semibold rounded-lg shadow-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition duration-200 transform hover:scale-105" %>
      </div>
    <% end %>

    <!-- 一覧に戻るリンク（オプション） -->
    <div class="mt-8 text-center">
      <%= link_to "一覧へ戻る", posts_path, 
                  class: "text-gray-600 hover:text-gray-800 font-medium transition" %>
    </div>
  </div>
</div>