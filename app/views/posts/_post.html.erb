<%= link_to post_path(post), class: "block hover:shadow-lg transition-shadow duration-300 rounded-lg overflow-hidden w-full max-w-md mx-auto" do %>
  <div class="bg-white rounded-lg shadow-sm">
    <div class="p-5">
      <h2 class="text-lg font-semibold text-gray-800 mb-3 line-clamp-2">
        <%= post.title %>
      </h2>

      <div class="flex items-center text-sm text-gray-600">
        <svg class="w-4 h-4 mr-2 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
        <span class="font-medium">
          <%= post.user.name || "匿名" %>
        </span>
      </div>
    </div>

    <div class="px-5 py-3 bg-gray-50 text-xs text-gray-500 border-t border-gray-100">
      <%= l post.created_at, format: :short %>
    </div>
  </div>
<% end %>