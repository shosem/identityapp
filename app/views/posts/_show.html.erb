<div class="container mx-auto px-4 py-12 max-w-4xl">
  <!-- タイトル -->
  <h1 class="text-4xl font-bold text-gray-900 mb-6 leading-tight">
    <%= @post.title %>
  </h1>

  <!-- 投稿情報（作成者 + 日時） -->
  <div class="flex items-center text-sm text-gray-600 mb-10 space-x-6">
    <div class="flex items-center">
      <svg class="w-5 h-5 mr-2 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
      </svg>
      <span class="font-medium text-gray-800">
        <%= @post.user.name || "匿名" %>
      </span>
    </div>

    <div class="flex items-center">
      <svg class="w-5 h-5 mr-2 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg>
      <time datetime="<%= @post.created_at.iso8601 %>" class="text-gray-600">
        <%= l @post.created_at, format: :long %>
      </time>
    </div>
  </div>

  <div class="mb-10 relative w-full" style="aspect-ratio: 19.5 / 9;">
    <div class="absolute inset-0 bg-gray-100 rounded-xl overflow-hidden">
      <%= image_tag @post.post_image_url, class: "w-full h-full object-contain bg-gray-100", alt: @post.title %>
    </div>
  </div>

  <!-- 本文 -->
  <div class="bg-white rounded-xl shadow-md p-8 prose prose-lg max-w-none text-gray-800 leading-relaxed">
    <%= simple_format @post.text %>
  </div>

  <!-- 戻るボタン（オプション） -->
  <% if @post.user.id == @current_user.id || admin? %>
    <div class="mt-12 flex flex-wrap gap-4 justify-center">
  <%= link_to "一覧に戻る", posts_path, 
              class: "inline-flex items-center px-6 py-3 bg-gray-200 text-gray-800 font-medium rounded-lg hover:bg-gray-300 transition" %>
  <%= link_to "編集", edit_post_path(@post), 
              class: "inline-flex items-center px-6 py-3 bg-gray-200 text-gray-800 font-medium rounded-lg hover:bg-gray-300 transition" %>
  <%= button_to "削除", @post, 
                method: :delete, 
                class: "inline-flex items-center px-6 py-3 bg-red-200 text-gray-800 font-medium rounded-lg hover:bg-red-300 transition" %>
</div>
  <% else %>
    <div class="mt-12">
      <%= link_to "一覧に戻る", posts_path, class: "inline-flex items-center px-6 py-3 bg-gray-200 text-gray-800 font-medium rounded-lg hover:bg-gray-300 transition" %>
    </div>
  <% end %>
</div>