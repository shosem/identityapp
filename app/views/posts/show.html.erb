<%= render 'show' %>
<% if admin? %>
  <%= render 'admin_comments' %>
<% else %>
<%= render 'comments' %>
<% end %>

<% if logged_in? %>
    <div class="mt-10 bg-white rounded-xl shadow-md p-8 max-w-3xl mx-auto">
      <h3 class="text-xl font-bold text-gray-800 mb-6">コメントを投稿する</h3>

      <%= form_with model: [@post, @post.comments.build], class: "space-y-6", data: { turbo: false } do |f| %>  <!-- turbo: false で通常POST -->

        <div>
          <%= f.text_area :content, rows: 5, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 resize-y", placeholder: "あなたのコメントを入力してください..." %>
        </div>

        <div class="text-right">
          <%= f.submit "投稿する", class: "px-8 py-3 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition duration-200" %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="mt-10 text-center text-gray-600">
      コメントするには <%= link_to "ログイン", login_path, class: "text-blue-600 underline hover:text-blue-800" %> してください
    </p>
  <% end %>