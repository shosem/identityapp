<h1 class="border-b border-black h-10 pt-2">投稿一覧</h1>
<br>

<div id="posts" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
  <% @posts.each do |post| %>
    <%= render post %>  <!-- _post.html.erb のカードがここに入る -->
  <% end %>
</div>

<% if current_user.present? %>
  <%= link_to "投稿する", new_post_path, class: "inline-flex items-center px-6 py-3 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition" %>
<% else %>
  <p class="mt-8">ログイン後、投稿・閲覧・コメントできるようになります！</p>
  <%= link_to "ログイン", login_path, class: "inline-flex items-center px-6 py-3 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition" %>
<% end %>