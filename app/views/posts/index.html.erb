<p style="color: green"><%= notice %></p>
<h1 class="border-b border-black h-10 pt-2">投稿一覧</h1>
<br>

<div id="posts">
<% @posts.each do |post| %>
<%= render post %>
<p style="color:blue">
<%= link_to "詳細", post %>
</p>
<br>
<% end %>
</div>

<%= link_to "新規作成", new_post_path, class:"border-2 border-black bg-blue-400 hover:bg-blue-200 text-black px-2 py-1 rounded"%>