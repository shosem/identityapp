<!DOCTYPE html>
<html>
  <head>
    <title>第五人格大会結果</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Myapp">
    <meta name="mobile-web-app-capable" content="yes">
   <script src="https://cdn.tailwindcss.com"></script>

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body class="...">
  <header class="sticky top-0 z-50 bg-gray-900 shadow-lg">
      <div class="flex items-center justify-between px-4 py-3 max-w-7xl mx-auto">
    <a href="#" class="text-white text-xl font-bold">
      第五人格大会結果
    </a>
      <div>
      <%= link_to "ログイン", new_user_path, class: "inline-block rounded-md bg-gray-700 px-6 py-3 text-sm font-semibold uppercase text-white transition hover:bg-gray-600" %>
    </div>
  </div>
    </header>
    <div class="min-h-screen flex">
    <!-- 以下、サイドバーの記述 -->
    <nav class="w-40 bg-blue-200 h-screen fixed left-0 top-50 overflow-y-auto pt-8 px-6 hidden md:block">
     <div class="space-y-4">
      <ul class="space-y-2">
        <li>
        <%= link_to 'トップ', root_path, class: "block py-2 px-4 text-blue-800 rounded-lg font-medium" %>
        </li>
        <li>
          <%= link_to 'ユーザー', users_path, class: "block py-2 px-4 text-blue-800 rounded-lg font-medium" %>
        </li>
        </ul>
        </div>
        </nav>

        <!--以下、メインコンテンツ-->
        <div class="flex-1 md:ml-40">
    <%= yield %>
    </div>
    </div>
  </body>
</html>
