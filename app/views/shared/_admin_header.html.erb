<header class="sticky top-0 z-50 bg-gray-900 shadow-lg">
  <div class="flex items-center justify-between px-2 py-3 max-w-7xl mx-auto">
    <%= link_to "第五人格掲示板", root_path, class: "text-white text-xl font-bold" %>
      <div>
       <li class="relative">
          <button
            type="button"
            class="flex focus:outline-none"
            onclick="document.getElementById('profile-dropdown').classList.toggle('hidden')"
            id="header-profile">
            <%= image_tag 'sample.png', class: "w-10 h-10 rounded-full object-cover" %>
          </button>
          <div
            id="profile-dropdown"
            class="hidden absolute right-0 mt-2 w-48 bg-white rounded-md shadow-lg py-1 z-50">
              <div class="px-4 py-2 text-sm text-gray-700">
              <%= current_user.name %>
          </div>
            <hr class="my-1 border-gray-200">
              <%= link_to "ユーザー一覧", users_path, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" %>

              <%= link_to t('header.logout'), logout_path,
                class: "block px-4 py-2 text-sm text-red-700 hover:bg-red-50",
                data: { turbo_method: :delete } %>
                
        </div>
        </li>
        </div>

      <div>
        <span class="inline-block rounded-md bg-gray-700 px-6 py-3 text-sm font-semibold text-white transition hover:bg-gray-600"><%= current_user.name %>さん、こんにちは！</span>
        <%= link_to "ログアウト", logout_path, class: "inline-block rounded-md bg-gray-700 px-6 py-3 text-sm font-semibold uppercase text-white transition hover:bg-gray-600", data: { turbo_method: :delete } %>
      </div>
  </div>
</header>