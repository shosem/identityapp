<!-- _sidebar.html.erb -->
<aside class="w-40 bg-white border-r border-gray-200 h-screen fixed left-0 top-0 overflow-y-auto pt-20 px-4 hidden md:block shadow-lg z-20">
  <!-- ヘッダー部分 -->
  <div class="mb-6">
    <h2 class="text-lg font-bold text-gray-800">メニュー</h2>
  </div>

  <!-- ナビゲーション -->
  <nav class="space-y-1">
    <ul class="space-y-1">
      <!-- 投稿リンク -->
      <li>
        <%= link_to posts_path, class: "flex items-center gap-2 py-2.5 px-3 text-gray-700 hover:bg-gray-100 rounded-md transition duration-200 text-sm" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>
          <span class="font-medium">投稿一覧</span>
        <% end %>
      </li>

      <% if admin? %>
      <li>
        <%= link_to users_path, class: "flex items-center gap-2 py-2.5 px-3 text-gray-700 hover:bg-gray-100 rounded-md transition duration-200 text-sm" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <span class="font-medium">ユーザー管理</span>
        <% end %>
      </li>
      <% end %>
    </ul>
  </nav>
</aside>